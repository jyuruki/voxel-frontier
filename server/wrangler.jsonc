{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "voxel-frontier-multiplayer",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://jyuruki.github.io,http://localhost:3000,http://127.0.0.1:3000"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "FrontierRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FrontierRoom"]
    }
  ]
}
