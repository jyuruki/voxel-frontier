{
  "name": "voxel-frontier",
  "version": "0.10.1",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:server": "wrangler dev --config server/wrangler.jsonc",
    "build": "next build",
    "build:pages": "NEXT_PUBLIC_BASE_PATH=/voxel-frontier VOXEL_STATIC_EXPORT=true next build",
    "start": "next start",
    "test": "npm run lint && npm run test:unit && npm run typecheck:server && npm run build:server && npm run test:multiplayer && npm run build:pages",
    "test:unit": "node --import tsx --test tests/game.test.ts",
    "test:all": "npm test",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern out --ignore-pattern dist",
    "typecheck:server": "tsc -p server/tsconfig.json",
    "build:server": "wrangler deploy --config server/wrangler.jsonc --dry-run --outdir dist/server",
    "test:multiplayer": "node tests/multiplayer.integration.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@cloudflare/workers-types": "5.20260808.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.180.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "miniflare": "5.20260801.1-alpha",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.3",
    "typescript": "5.9.3",
    "wrangler": "4.120.0"
  },
  "type": "module",
  "displayName": "Voxel Frontier"
}
